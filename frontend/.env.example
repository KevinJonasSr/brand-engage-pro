# Canonical production origin. Never $VERCEL_URL, *.vercel.app, or apex.
# Apex already 308s to www — keep that. Do not use apex as a landing host
# or email redirect target.
NEXT_PUBLIC_APP_URL=https://www.brandengagepro.com
# NEXT_PUBLIC_SITE_URL=https://www.brandengagepro.com

# Magic-link and forgot-password doors.
# Off when VERCEL_ENV / NEXT_PUBLIC_VERCEL_ENV is production unless
# the matching flag below is explicitly true.
# Do NOT set NEXT_PUBLIC_MAGIC_LINK_ENABLED=true or
# NEXT_PUBLIC_FORGOT_PASSWORD_ENABLED=true in production.
# NEXT_PUBLIC_MAGIC_LINK_ENABLED=
# NEXT_PUBLIC_FORGOT_PASSWORD_ENABLED=

# Cloudflare Turnstile — BEP's own widget (not Fan Engage's site key).
# Production: both keys required. Host allowlist must include
# www.brandengagepro.com (see docs/TURNSTILE_WWW_ALLOWLIST.md).
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# TURNSTILE_ALLOW_BYPASS=

# Email campaigns (Mailchimp Transactional / Mandrill). The sending domain must be verified in Mandrill.
# The key alone does not send. EMAIL_SENDING_ENABLED must be exactly 1.
# Leave it at 0 until you mean to send. Do not use the old broadcast flag.
EMAIL_SENDING_ENABLED=0
MAILCHIMP_TRANSACTIONAL_API_KEY=
BEP_EMAIL_FROM=hello@brandengagepro.com
BEP_EMAIL_REPLY_TO=support@brandengagepro.com
# Physical mailing address printed in marketing email footers. Required before sends.
# One line, for example a street, city, state and ZIP. Not a placeholder.
# BEP_MAILING_ADDRESS=

# Signs the in-store check-in QR codes (proof of presence). Any long random string,
# for example: openssl rand -base64 32. When unset, check-ins are not verified.
# Changing it invalidates every printed QR code.
CHECKIN_SIGNING_SECRET=
